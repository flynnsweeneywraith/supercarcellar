{%- comment -%}
  Supercar Cellar — Landing hero (split, dark, AMMO restraint)
  Section prefix: scc- · Tokens defined once here, reused by all scc- sections.
{%- endcomment -%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@75..125,400..900&display=swap" rel="stylesheet">

{%- style -%}
  :root{
    --scc-bg:#0a0a0c; --scc-panel:#111114; --scc-ink:#e6e7ea; --scc-mut:#9ea0a8;
    --scc-acc:#8e1f2c; --scc-acc-hi:#a52534; --scc-line:rgba(230,231,234,.08);
    --scc-display:"Archivo",system-ui,sans-serif;
    --scc-r:2px; --scc-gap:clamp(56px,9vw,128px);
  }
  .scc{background:var(--scc-bg);color:var(--scc-ink);font-family:var(--scc-display);font-size:16px;line-height:1.6;overflow-x:clip}
  .scc-bglayer{position:absolute;inset:0;pointer-events:none;overflow:hidden}
  .scc-bglayer img{width:100%;height:100%;object-fit:cover;opacity:.13;
    -webkit-mask-image:linear-gradient(180deg,transparent 0%,#000 18%,#000 78%,transparent 100%);
    mask-image:linear-gradient(180deg,transparent 0%,#000 18%,#000 78%,transparent 100%)}
  .scc *{box-sizing:border-box;margin:0}
  .scc-wrap{max-width:1320px;margin:0 auto;padding-inline:clamp(20px,4vw,48px)}
  .scc-label{font-size:11px;font-weight:600;letter-spacing:.22em;text-transform:uppercase;color:var(--scc-mut)}
  .scc-btn{position:relative;overflow:hidden;display:inline-flex;align-items:center;gap:10px;background:var(--scc-acc);color:#fff;text-decoration:none;
    font-weight:700;font-size:14px;letter-spacing:.06em;text-transform:uppercase;padding:18px 34px;border-radius:var(--scc-r);
    border:0;cursor:pointer;transition:background .2s ease,transform .12s ease,box-shadow .3s ease;min-height:44px}
  .scc-btn:hover{background:var(--scc-acc-hi);box-shadow:0 8px 32px rgba(142,31,44,.35)}
  .scc-btn:active{transform:translateY(1px)}
  .scc-btn--ghost{background:transparent;border:1px solid var(--scc-line);color:var(--scc-ink)}
  .scc-btn--ghost:hover{background:rgba(230,231,234,.06)}
  @media (prefers-reduced-motion:no-preference){
    .scc-reveal{opacity:0;transform:translateY(26px);transition:opacity .8s cubic-bezier(.16,1,.3,1),transform .8s cubic-bezier(.16,1,.3,1)}
    .scc-reveal-l{opacity:0;transform:translateX(-44px);transition:opacity .9s cubic-bezier(.16,1,.3,1),transform .9s cubic-bezier(.16,1,.3,1)}
    .scc-reveal-r{opacity:0;transform:translateX(44px);transition:opacity .9s cubic-bezier(.16,1,.3,1),transform .9s cubic-bezier(.16,1,.3,1)}
    .scc-reveal.is-in,.scc-reveal-l.is-in,.scc-reveal-r.is-in{opacity:1;transform:none}
    .scc-lines span{display:block;overflow:hidden}
    .scc-lines span i{display:block;font-style:normal;transform:translateY(110%);transition:transform .9s cubic-bezier(.16,1,.3,1)}
    .scc-lines.is-in span:nth-child(1) i{transition-delay:.05s}
    .scc-lines.is-in span:nth-child(2) i{transition-delay:.15s}
    .scc-lines.is-in span i{transform:none}
    @keyframes scc-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-16px)}}
    @keyframes scc-kb{0%{transform:scale(1)}100%{transform:scale(1.09)}}
    @keyframes scc-glow{0%,100%{opacity:.55}50%{opacity:1}}
    @keyframes scc-marquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
    .scc-hero__media img{animation:scc-float 7s ease-in-out infinite}
    .scc-kb img{animation:scc-kb 22s linear infinite alternate}
    .scc-final::after{animation:scc-glow 6s ease-in-out infinite}
    .scc-marquee__track{animation:scc-marquee 36s linear infinite}
    .scc-marquee:hover .scc-marquee__track{animation-play-state:paused}
    .scc-how__step::after{width:0;transition:width .8s cubic-bezier(.16,1,.3,1) .2s}
    .scc-how__step.is-in::after{width:44px}
    .scc-btn::after{content:"";position:absolute;top:0;left:-80%;width:50%;height:100%;
      background:linear-gradient(100deg,transparent,rgba(255,255,255,.28),transparent);transform:skewX(-20deg);transition:left .6s ease}
    .scc-btn:hover::after{left:130%}
  }

  .scc-hero{position:relative;overflow:hidden;padding-block:clamp(48px,7vw,96px) clamp(36px,4.5vw,64px)}
  .scc-hero::before{content:"";position:absolute;inset:0;pointer-events:none;z-index:1;
    background:radial-gradient(90% 70% at 78% 30%,rgba(142,31,44,.16),transparent 60%)}
  .scc-hero .scc-wrap{position:relative;z-index:2}
  .scc-hero__grid{display:grid;gap:48px;align-items:center;position:relative}
  .scc-hero__logo{display:block;height:clamp(64px,7vw,88px);width:auto;margin-bottom:26px}
  .scc-hero__h1{font-size:clamp(40px,6.2vw,88px);line-height:.98;font-weight:800;letter-spacing:-.025em;
    font-stretch:112%;text-wrap:balance;margin:22px 0 24px}
  .scc-hero__h1 em{font-style:normal;color:var(--scc-acc-hi)}
  .scc-hero__sub{color:var(--scc-mut);font-size:clamp(16px,1.4vw,19px);max-width:46ch;margin-bottom:34px}
  .scc-hero__ctas{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:38px}
  .scc-hero__trust{display:flex;flex-wrap:wrap;gap:10px 28px;padding-top:22px;border-top:1px solid var(--scc-line)}
  .scc-hero__trust span{font-size:12.5px;color:var(--scc-mut);letter-spacing:.04em}
  .scc-hero__media{position:relative}
  .scc-hero__media img{display:block;width:100%;height:auto;border-radius:var(--scc-r);
    filter:drop-shadow(0 40px 80px rgba(0,0,0,.55))}
  @media(min-width:900px){.scc-hero__grid{grid-template-columns:1.05fr .95fr;gap:clamp(48px,5vw,88px)}}

  .scc-marques{position:relative;background:#dfe0e4;border-block:1px solid rgba(10,10,12,.35);overflow:hidden;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);
    mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent)}
  .scc-marques__track{display:flex;width:max-content;padding-block:22px}
  .scc-marques__set{display:flex;align-items:center;gap:clamp(44px,6vw,88px);padding-right:clamp(44px,6vw,88px)}
  .scc-marques__set img{display:block;height:34px;width:auto;filter:grayscale(1);opacity:.82}
  @media (prefers-reduced-motion:no-preference){
    .scc-marques__track{animation:scc-marquee 42s linear infinite}
    .scc-marques:hover .scc-marques__track{animation-play-state:paused}
  }

  .scc-stats{border-block:1px solid var(--scc-line);background:var(--scc-panel)}
  .scc-stats__grid{display:grid;gap:0}
  .scc-stats__cell{padding:clamp(26px,3vw,40px) clamp(20px,3vw,44px);border-top:1px solid var(--scc-line)}
  .scc-stats__num{font-size:clamp(38px,4.4vw,60px);font-weight:800;letter-spacing:-.02em;font-stretch:110%;
    font-variant-numeric:tabular-nums;line-height:1}
  .scc-stats__num sub{font-size:.38em;font-weight:600;color:var(--scc-mut);vertical-align:baseline;margin-left:4px}
  .scc-stats__cap{color:var(--scc-mut);font-size:13.5px;margin-top:10px;max-width:26ch}
  @media(min-width:768px){
    .scc-stats__grid{grid-template-columns:repeat(3,1fr)}
    .scc-stats__cell{border-top:0}
    .scc-stats__cell+.scc-stats__cell{border-left:1px solid var(--scc-line)}
  }
{%- endstyle -%}

<div class="scc">
  <section class="scc-hero">
    <div class="scc-bglayer scc-kb">
      {%- if section.settings.bg_image != blank -%}
        {{ section.settings.bg_image | image_url: width: 2000 | image_tag: alt: '', loading: 'eager' }}
      {%- else -%}
        <img src="https://cdn.shopify.com/s/files/1/0720/0296/1578/files/cellar-dark.jpg" alt="" loading="eager">
      {%- endif -%}
    </div>
    <div class="scc-wrap">
      <div class="scc-hero__grid">
        <div>
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 400 | image_tag: class: 'scc-hero__logo scc-reveal', alt: 'Supercar Cellar', loading: 'eager' }}
          {%- else -%}
            <img class="scc-hero__logo scc-reveal" src="https://cdn.shopify.com/s/files/1/0720/0296/1578/files/supercar-cellar-logo.png"
              alt="Supercar Cellar" width="637" height="546" loading="eager">
          {%- endif -%}
          <p class="scc-label scc-reveal">{{ section.settings.eyebrow }}</p>
          <h1 class="scc-hero__h1 scc-lines">
            <span><i>{{ section.settings.heading_1 }}</i></span><span><i><em>{{ section.settings.heading_2 }}</em></i></span>
          </h1>
          <p class="scc-hero__sub scc-reveal" style="transition-delay:.12s">{{ section.settings.subtext }}</p>
          <div class="scc-hero__ctas scc-reveal" style="transition-delay:.18s">
            <a class="scc-btn" href="#scc-buy">{{ section.settings.cta_label }}</a>
            <a class="scc-btn scc-btn--ghost" href="#scc-how">{{ section.settings.cta2_label }}</a>
          </div>
          <div class="scc-hero__trust scc-reveal" style="transition-delay:.24s">
            <span>{{ section.settings.trust_1 }}</span>
            <span>{{ section.settings.trust_2 }}</span>
            <span>{{ section.settings.trust_3 }}</span>
          </div>
        </div>
        <div class="scc-hero__media scc-reveal" style="transition-delay:.1s">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1600 | image_tag:
                widths: '640,960,1254,1600', sizes: '(min-width:900px) 46vw, 92vw',
                alt: section.settings.image.alt | default: 'Cord Cushion packaging', loading: 'eager', fetchpriority: 'high' }}
          {%- else -%}
            <img src="https://cdn.shopify.com/s/files/1/0720/0296/1578/files/sleeve-coiled.png?v=1785465889"
              alt="Cord Cushion matte black woven sleeve fitted over a battery tender cable" width="1254" height="1254" loading="eager" fetchpriority="high">
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- capture marque_set -%}
    {%- assign cdn = 'https://cdn.shopify.com/s/files/1/0720/0296/1578/files/' -%}
    <img src="{{ cdn }}marque-porsche.png" alt="Porsche" loading="lazy" height="34">
    <img src="{{ cdn }}marque-ferrari.svg" alt="Ferrari" loading="lazy" height="34">
    <img src="{{ cdn }}marque-lamborghini.svg" alt="Lamborghini" loading="lazy" height="34">
    <img src="{{ cdn }}marque-mclaren.svg" alt="McLaren" loading="lazy" height="34">
    <img src="{{ cdn }}marque-aston-martin.svg" alt="Aston Martin" loading="lazy" height="34">
    <img src="{{ cdn }}marque-bentley.svg" alt="Bentley" loading="lazy" height="34">
    <img src="{{ cdn }}marque-rolls-royce.svg" alt="Rolls-Royce" loading="lazy" height="34">
    <img src="{{ cdn }}marque-alfa-romeo.svg" alt="Alfa Romeo" loading="lazy" height="34">
    <img src="{{ cdn }}marque-chevrolet.svg" alt="Chevrolet" loading="lazy" height="34">
  {%- endcapture -%}
  <div class="scc-marques" role="img" aria-label="Fits tenders used on Porsche, Ferrari, Lamborghini, McLaren, Aston Martin, Bentley, Rolls-Royce, Alfa Romeo and Chevrolet garages">
    <div class="scc-marques__track">
      <div class="scc-marques__set" aria-hidden="true">{{ marque_set }}</div>
      <div class="scc-marques__set" aria-hidden="true">{{ marque_set }}</div>
    </div>
  </div>

  <section class="scc-stats" aria-label="Product facts">
    <div class="scc-wrap" style="padding-inline:0">
      <div class="scc-stats__grid">
        {%- for block in section.blocks -%}
          <div class="scc-stats__cell scc-reveal" {{ block.shopify_attributes }}>
            <p class="scc-stats__num">{%- if block.settings.count_up -%}<span data-count="{{ block.settings.value }}">0</span>{%- else -%}{{ block.settings.value }}{%- endif -%}<sub>{{ block.settings.unit }}</sub></p>
            <p class="scc-stats__cap">{{ block.settings.caption }}</p>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

<script>
  (function(){
    var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    function arm(){
      var els = document.querySelectorAll('.scc-reveal,.scc-reveal-l,.scc-reveal-r,.scc-lines,.scc-how__step');
      if (reduce) {
        els.forEach(function(el){ el.classList.add('is-in'); });
        document.querySelectorAll('[data-count]').forEach(function(c){ c.textContent = c.dataset.count; });
        return;
      }
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if(!e.isIntersecting) return;
          e.target.classList.add('is-in');
          var counter = e.target.querySelector('[data-count]');
          if (counter && !counter.dataset.done) {
            counter.dataset.done = '1';
            var target = parseInt(counter.dataset.count, 10), start = null;
            function tick(ts){
              if(!start) start = ts;
              var p = Math.min((ts - start) / 1200, 1);
              counter.textContent = Math.round(target * (1 - Math.pow(1 - p, 3)));
              if (p < 1) requestAnimationFrame(tick);
            }
            requestAnimationFrame(tick);
          }
          io.unobserve(e.target);
        });
      }, {threshold:.18});
      els.forEach(function(el){ io.observe(el); });
    }
    if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', arm); } else { arm(); }
  })();
</script>

{% schema %}
{
  "name": "SCC Hero + Stats",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Brand logo" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image (rendered at 13% opacity)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Paint Protection" },
    { "type": "text", "id": "heading_1", "label": "Headline (silver part)", "default": "The tender keeps the battery." },
    { "type": "text", "id": "heading_2", "label": "Headline (accent part)", "default": "This keeps the paint." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Car care for the cable you can't unplug. A matte woven sleeve keeping the tender off your clear coat." },
    { "type": "text", "id": "cta_label", "label": "Primary CTA", "default": "Buy Cord Cushion" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA", "default": "See how it works" },
    { "type": "image_picker", "id": "image", "label": "Hero image" },
    { "type": "text", "id": "trust_1", "label": "Trust item 1", "default": "Ships from Australia, worldwide" },
    { "type": "text", "id": "trust_2", "label": "Trust item 2", "default": "Fits common battery tenders" },
    { "type": "text", "id": "trust_3", "label": "Trust item 3", "default": "Secure checkout" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "0" },
        { "type": "text", "id": "unit", "label": "Unit (small)" },
        { "type": "text", "id": "caption", "label": "Caption", "default": "metal parts touching your paint" },
        { "type": "checkbox", "id": "count_up", "label": "Animate number counting up", "default": false }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "SCC Hero + Stats" }]
}
{% endschema %}
