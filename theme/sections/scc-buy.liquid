{%- comment -%}
  Supercar Cellar — Buy module, product-page layout (Grüns-style structure,
  SCC dark aesthetic). Red offer banner over the gallery, 1-or-2 quantity
  tabs (Twin Pack in accent red, pre-selected, savings anchored), detail
  panel per option, AJAX add-to-cart (/cart/add.js), Product JSON-LD,
  sticky mobile buy bar. Products come from section settings.
{%- endcomment -%}

{%- assign p_single = section.settings.product_single -%}
{%- assign p_twin = section.settings.product_twin -%}
{%- assign single_price = 0 -%}{%- assign twin_price = 0 -%}
{%- if p_single != blank and p_single.variants.first != blank -%}
  {%- assign single_price = p_single.variants.first.price -%}
{%- endif -%}
{%- if p_twin != blank and p_twin.variants.first != blank -%}
  {%- assign twin_price = p_twin.variants.first.price -%}
{%- endif -%}
{%- assign twin_was = single_price | times: 2 -%}
{%- assign twin_saving = twin_was | minus: twin_price -%}
{%- assign per_sleeve = twin_price | divided_by: 2 -%}

{%- style -%}
  .scc-buy{border-block:1px solid var(--scc-line,rgba(230,231,234,.08));background:var(--scc-panel,#111114);
    padding-block:var(--scc-gap,96px);scroll-margin-top:90px}
  .scc-buy__grid{display:grid;gap:44px;align-items:start}
  @media(min-width:900px){.scc-buy__grid{grid-template-columns:1.02fr .98fr;gap:clamp(44px,5vw,84px)}}

  /* gallery with offer banner */
  @media(min-width:900px){.scc-buy__gallery{position:sticky;top:24px}}
  .scc-buy__frame{border:1px solid var(--scc-line,rgba(230,231,234,.08));border-radius:2px;overflow:hidden;
    background:var(--scc-bg,#0a0a0c)}
  .scc-buy__banner{background:var(--scc-acc,#8e1f2c);color:#fff;text-align:center;font-size:13px;font-weight:800;
    letter-spacing:.14em;text-transform:uppercase;padding:12px 16px}
  .scc-buy__main img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover}
  .scc-buy__thumbs{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:10px}
  .scc-buy__thumb{padding:0;border:1px solid var(--scc-line,rgba(230,231,234,.08));border-radius:2px;overflow:hidden;
    background:var(--scc-bg,#0a0a0c);cursor:pointer;transition:border-color .2s ease,opacity .2s ease;opacity:.65}
  .scc-buy__thumb img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover}
  .scc-buy__thumb[aria-current="true"]{border-color:var(--scc-acc-hi,#a52534);opacity:1}
  .scc-buy__thumb:hover{opacity:1}
  .scc-buy__thumb:focus-visible{outline:2px solid var(--scc-acc-hi,#a52534);outline-offset:2px}

  /* panel */
  .scc-buy__panel .scc-h2{font-size:clamp(28px,3.2vw,44px);font-weight:800;letter-spacing:-.02em;line-height:1.05;
    margin-top:16px;text-wrap:balance}
  .scc-buy__sub{color:var(--scc-mut,#9ea0a8);margin-top:14px;max-width:48ch}
  .scc-buy__select-label{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;
    margin:30px 0 14px;color:var(--scc-ink,#e6e7ea)}

  /* quantity tabs */
  .scc-buy__tabs{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .scc-buy__tab{position:relative;font:inherit;border-radius:2px;padding:18px 14px;cursor:pointer;text-align:center;
    font-size:14px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;min-height:56px;
    transition:border-color .2s ease,box-shadow .2s ease,transform .15s ease}
  .scc-buy__tab:hover{transform:translateY(-2px)}
  .scc-buy__tab:focus-visible{outline:2px solid var(--scc-acc-hi,#a52534);outline-offset:3px}
  .scc-buy__tab--one{background:transparent;border:1px solid rgba(230,231,234,.25);color:var(--scc-ink,#e6e7ea)}
  .scc-buy__tab--one[aria-checked="true"]{border-color:var(--scc-ink,#e6e7ea);box-shadow:inset 0 0 0 1px var(--scc-ink,#e6e7ea)}
  .scc-buy__tab--two{background:var(--scc-acc,#8e1f2c);border:1px solid var(--scc-acc,#8e1f2c);color:#fff}
  .scc-buy__tab--two:hover{background:var(--scc-acc-hi,#a52534)}
  .scc-buy__tab--two[aria-checked="true"]{border-color:#fff;box-shadow:inset 0 0 0 1px #fff,0 10px 30px rgba(142,31,44,.4)}
  .scc-buy__tab-badge{position:absolute;top:-11px;right:10px;background:#fff;color:var(--scc-acc,#8e1f2c);
    font-size:10.5px;font-weight:800;letter-spacing:.1em;padding:3px 9px;border-radius:2px;white-space:nowrap}
  .scc-buy__tab-sub{display:block;font-size:11px;font-weight:600;letter-spacing:.04em;text-transform:none;
    margin-top:4px;opacity:.75}

  /* detail box for the selected option */
  .scc-buy__detail{border:1px solid var(--scc-line,rgba(230,231,234,.08));border-top-width:0;border-radius:0 0 2px 2px;
    background:var(--scc-bg,#0a0a0c);padding:22px;margin-top:14px;display:grid;grid-template-columns:1fr auto;
    gap:8px 18px;align-items:center}
  .scc-buy__detail[hidden]{display:none}
  .scc-buy__amount{font-variant-numeric:tabular-nums}
  .scc-buy__amount strong{font-size:clamp(28px,2.6vw,36px);font-weight:800;letter-spacing:-.01em}
  .scc-buy__amount s{color:var(--scc-mut,#9ea0a8);font-size:15px;margin-left:10px}
  .scc-buy__amount .scc-buy__save{display:inline-block;background:var(--scc-acc,#8e1f2c);color:#fff;font-size:11.5px;
    font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:3px 9px;border-radius:2px;margin-left:12px;
    vertical-align:middle}
  .scc-buy__per{color:var(--scc-mut,#9ea0a8);font-size:13px;margin-top:4px}
  .scc-buy__packshot{grid-row:span 2;width:84px}
  .scc-buy__packshot img{display:block;width:84px;height:84px;object-fit:cover;border-radius:2px;
    border:1px solid var(--scc-line,rgba(230,231,234,.08))}
  .scc-buy__packshot figcaption{font-size:10.5px;color:var(--scc-mut,#9ea0a8);text-align:center;margin-top:6px}
  .scc-buy__checks{margin:10px 0 0;padding:0;list-style:none;display:grid;gap:8px;grid-column:1 / -1}
  .scc-buy__checks li{display:flex;gap:10px;align-items:baseline;color:var(--scc-mut,#9ea0a8);font-size:14px}
  .scc-buy__checks li::before{content:"";flex:none;width:13px;height:7px;transform:translateY(-1px) rotate(-45deg);
    border-left:2px solid var(--scc-acc-hi,#a52534);border-bottom:2px solid var(--scc-acc-hi,#a52534)}

  .scc-buy__actions{margin-top:22px;display:grid;gap:12px}
  .scc-buy__submit{width:100%;justify-content:center;font-size:15px;padding:20px 34px}
  .scc-buy__msg{font-size:13.5px;color:var(--scc-mut,#9ea0a8);text-align:center;min-height:1.2em}
  .scc-buy__msg.is-ok{color:#8fbf9a}
  .scc-buy__msg.is-err{color:#d98b95}

  .scc-buy__assure{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:26px;
    border-top:1px solid var(--scc-line,rgba(230,231,234,.08));padding-top:22px}
  .scc-buy__assure p{font-size:12.5px;color:var(--scc-mut,#9ea0a8);line-height:1.45}
  .scc-buy__assure p strong{display:block;color:var(--scc-ink,#e6e7ea);font-size:12.5px;font-weight:700;
    letter-spacing:.08em;text-transform:uppercase;margin-bottom:4px}
  .scc-buy__fine{margin-top:18px;font-size:12.5px;color:#6a6c74}

  .scc-stickybar{position:fixed;left:0;right:0;bottom:0;z-index:40;display:none;background:rgba(10,10,12,.92);
    backdrop-filter:blur(10px);border-top:1px solid var(--scc-line,rgba(230,231,234,.08));padding:12px 16px}
  .scc-stickybar.is-on{display:flex;align-items:center;justify-content:space-between;gap:16px}
  .scc-stickybar__price{font-weight:800;font-size:18px;font-variant-numeric:tabular-nums}
  .scc-stickybar__label{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--scc-mut,#9ea0a8)}
  .scc-stickybar .scc-btn{padding:14px 26px;font-size:13px}
  @media(min-width:900px){.scc-stickybar.is-on{display:none}}
{%- endstyle -%}

{%- assign cdn = 'https://cdn.shopify.com/s/files/1/0720/0296/1578/files/' -%}
{%- capture g1 -%}{%- if section.settings.gallery_1 != blank -%}{{ section.settings.gallery_1 | image_url: width: 1200 }}{%- else -%}{{ cdn }}packaging-hero.png{%- endif -%}{%- endcapture -%}
{%- capture g2 -%}{%- if section.settings.gallery_2 != blank -%}{{ section.settings.gallery_2 | image_url: width: 1200 }}{%- else -%}{{ cdn }}sleeve-coiled.png{%- endif -%}{%- endcapture -%}
{%- capture g3 -%}{%- if section.settings.gallery_3 != blank -%}{{ section.settings.gallery_3 | image_url: width: 1200 }}{%- else -%}{{ cdn }}solution-sleeve-fitted.png{%- endif -%}{%- endcapture -%}
{%- capture g4 -%}{%- if section.settings.gallery_4 != blank -%}{{ section.settings.gallery_4 | image_url: width: 1200 }}{%- else -%}{{ cdn }}problem-cable-on-paint.png{%- endif -%}{%- endcapture -%}

<div class="scc">
  <section class="scc-buy" id="scc-buy">
    <div class="scc-wrap">
      <div class="scc-buy__grid">

        <div class="scc-buy__gallery scc-reveal-l">
          <div class="scc-buy__frame">
            <p class="scc-buy__banner">{{ section.settings.banner_text }}</p>
            <div class="scc-buy__main">
              <img id="scc-buy-mainimg" src="{{ g1 | strip }}"
                alt="Cord Cushion retail packaging, black zip-seal bag with the sleeve looping out of the top" width="1200" height="1200" loading="lazy">
            </div>
          </div>
          <div class="scc-buy__thumbs" aria-label="Product photos">
            <button type="button" class="scc-buy__thumb" aria-current="true" data-full="{{ g1 | strip }}">
              <img src="{{ g1 | strip }}" alt="Retail packaging" width="300" height="300" loading="lazy">
            </button>
            <button type="button" class="scc-buy__thumb" aria-current="false" data-full="{{ g2 | strip }}">
              <img src="{{ g2 | strip }}" alt="Sleeve on the cable, coiled" width="300" height="300" loading="lazy">
            </button>
            <button type="button" class="scc-buy__thumb" aria-current="false" data-full="{{ g3 | strip }}">
              <img src="{{ g3 | strip }}" alt="Sleeve fitted where the cable meets the car" width="300" height="300" loading="lazy">
            </button>
            <button type="button" class="scc-buy__thumb" aria-current="false" data-full="{{ g4 | strip }}">
              <img src="{{ g4 | strip }}" alt="Bare cable resting on paint" width="300" height="300" loading="lazy">
            </button>
          </div>
        </div>

        <div class="scc-buy__panel scc-reveal-r">
          <p class="scc-label">{{ section.settings.eyebrow }}</p>
          <h2 class="scc-h2">{{ section.settings.heading }}</h2>
          <p class="scc-buy__sub">{{ section.settings.subtext }}</p>

          <form id="scc-buy-form">
            <p class="scc-buy__select-label">{{ section.settings.select_label }}</p>
            <div class="scc-buy__tabs" role="radiogroup" aria-label="Choose quantity">

              {%- if p_single != blank and p_single.variants.first != blank -%}
              <button type="button" class="scc-buy__tab scc-buy__tab--one" role="radio" aria-checked="false"
                      data-option="one"
                      data-variant-id="{{ p_single.variants.first.id }}"
                      data-price="{{ single_price | money }}">
                {{ section.settings.tab1_label }}
                <span class="scc-buy__tab-sub">{{ single_price | money }}</span>
              </button>
              {%- endif -%}

              {%- if p_twin != blank and p_twin.variants.first != blank -%}
              <button type="button" class="scc-buy__tab scc-buy__tab--two" role="radio" aria-checked="true"
                      data-option="two"
                      data-variant-id="{{ p_twin.variants.first.id }}"
                      data-price="{{ twin_price | money }}">
                {%- if single_price > 0 and twin_saving > 0 -%}
                  <span class="scc-buy__tab-badge">Save {{ twin_saving | money }}</span>
                {%- endif -%}
                {{ section.settings.tab2_label }}
                <span class="scc-buy__tab-sub">{{ section.settings.tab2_sub }}</span>
              </button>
              {%- endif -%}

            </div>

            {%- if p_single != blank and p_single.variants.first != blank -%}
            <div class="scc-buy__detail" data-detail="one" hidden>
              <p class="scc-buy__amount"><strong>{{ single_price | money }}</strong></p>
              <figure class="scc-buy__packshot">
                <img src="{{ g2 | strip }}" alt="" width="84" height="84" loading="lazy">
                <figcaption>1 sleeve</figcaption>
              </figure>
              <p class="scc-buy__per">One sleeve for one cable</p>
              <ul class="scc-buy__checks">
                <li>{{ section.settings.check_1 }}</li>
                <li>{{ section.settings.check_2 }}</li>
                <li>{{ section.settings.check_3 }}</li>
              </ul>
            </div>
            {%- endif -%}

            {%- if p_twin != blank and p_twin.variants.first != blank -%}
            <div class="scc-buy__detail" data-detail="two">
              <p class="scc-buy__amount">
                <strong>{{ twin_price | money }}</strong>
                {%- if single_price > 0 -%}<s>{{ twin_was | money }}</s>{%- endif -%}
                {%- if single_price > 0 and twin_saving > 0 -%}<span class="scc-buy__save">Second sleeve 50% off</span>{%- endif -%}
              </p>
              <figure class="scc-buy__packshot">
                <img src="{{ g1 | strip }}" alt="" width="84" height="84" loading="lazy">
                <figcaption>2 sleeves</figcaption>
              </figure>
              <p class="scc-buy__per">{{ per_sleeve | money }} per sleeve instead of {{ single_price | money }}</p>
              <ul class="scc-buy__checks">
                {%- if twin_saving > 0 -%}<li>{{ twin_saving | money }} off buying the pair together</li>{%- endif -%}
                <li>One for each car sitting on a tender</li>
                <li>{{ section.settings.check_3 }}</li>
              </ul>
            </div>
            {%- endif -%}

            <div class="scc-buy__actions">
              <button type="submit" class="scc-btn scc-buy__submit">{{ section.settings.button_label }} — <span id="scc-buy-btnprice">{% if twin_price > 0 %}{{ twin_price | money }}{% else %}{{ single_price | money }}{% endif %}</span></button>
              <p class="scc-buy__msg" id="scc-buy-msg" role="status" aria-live="polite"></p>
            </div>
          </form>

          <div class="scc-buy__assure">
            <p><strong>{{ section.settings.assure_1_title }}</strong>{{ section.settings.assure_1_body }}</p>
            <p><strong>{{ section.settings.assure_2_title }}</strong>{{ section.settings.assure_2_body }}</p>
            <p><strong>{{ section.settings.assure_3_title }}</strong>{{ section.settings.assure_3_body }}</p>
          </div>
          <p class="scc-buy__fine">{{ section.settings.fine_print }}</p>
        </div>

      </div>
    </div>
  </section>

  <div class="scc-stickybar" id="scc-stickybar" aria-hidden="true">
    <div>
      <p class="scc-stickybar__label">Cord Cushion</p>
      <p class="scc-stickybar__price" id="scc-stickybar-price">
        {%- if twin_price > 0 -%}{{ twin_price | money }}{%- elsif single_price > 0 -%}{{ single_price | money }}{%- endif -%}
      </p>
    </div>
    <a class="scc-btn" href="#scc-buy">{{ section.settings.button_label }}</a>
  </div>
</div>

{%- if p_single != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ p_single.title | json }},
  "description": {{ p_single.description | strip_html | truncate: 300 | json }},
  "image": [{%- for img in p_single.images -%}{{ img | image_url: width: 1254 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  "brand": { "@type": "Brand", "name": "Supercar Cellar" },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "lowPrice": {{ p_single.variants.first.price | divided_by: 100.0 | json }},
    "highPrice": {% if p_twin != blank %}{{ p_twin.variants.first.price | divided_by: 100.0 | json }}{% else %}{{ p_single.variants.first.price | divided_by: 100.0 | json }}{% endif %},
    "availability": "https://schema.org/{% if p_single.available %}InStock{% else %}PreOrder{% endif %}"
  }
}
</script>
{%- endif -%}

<script>
  (function(){
    var form = document.getElementById('scc-buy-form');
    if(!form) return;
    var tabs = form.querySelectorAll('.scc-buy__tab');
    var details = form.querySelectorAll('.scc-buy__detail');
    var msg = document.getElementById('scc-buy-msg');
    var btnPrice = document.getElementById('scc-buy-btnprice');
    var stickyPrice = document.getElementById('scc-stickybar-price');

    function select(tab){
      tabs.forEach(function(t){ t.setAttribute('aria-checked', t === tab ? 'true' : 'false'); });
      details.forEach(function(d){ d.hidden = d.dataset.detail !== tab.dataset.option; });
      if(btnPrice) btnPrice.textContent = tab.dataset.price;
      if(stickyPrice) stickyPrice.textContent = tab.dataset.price;
    }
    tabs.forEach(function(tab){
      tab.addEventListener('click', function(){ select(tab); });
    });
    var initial = form.querySelector('.scc-buy__tab[aria-checked="true"]') || tabs[0];
    if(initial) select(initial);

    var mainImg = document.getElementById('scc-buy-mainimg');
    var thumbs = document.querySelectorAll('.scc-buy__thumb');
    thumbs.forEach(function(t){
      t.addEventListener('click', function(){
        thumbs.forEach(function(o){ o.setAttribute('aria-current', o === t ? 'true' : 'false'); });
        if(mainImg){
          mainImg.src = t.dataset.full;
          var inner = t.querySelector('img');
          if(inner) mainImg.alt = inner.alt;
        }
      });
    });

    form.addEventListener('submit', function(e){
      e.preventDefault();
      var chosen = form.querySelector('.scc-buy__tab[aria-checked="true"]');
      if(!chosen){ return; }
      msg.className = 'scc-buy__msg';
      msg.textContent = 'Adding…';
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: Number(chosen.dataset.variantId), quantity: 1 })
      }).then(function(r){
        if(!r.ok) throw r;
        return r.json();
      }).then(function(){
        msg.className = 'scc-buy__msg is-ok';
        msg.innerHTML = 'Added. <a href="/cart" style="color:inherit;text-decoration:underline">Review your cart</a>';
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      }).catch(function(){
        msg.className = 'scc-buy__msg is-err';
        msg.textContent = 'Could not add to cart. Please try again.';
      });
    });

    var buy = document.getElementById('scc-buy');
    var bar = document.getElementById('scc-stickybar');
    if(buy && bar && 'IntersectionObserver' in window){
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          var showing = !en.isIntersecting && en.boundingClientRect.top > 0;
          bar.classList.toggle('is-on', showing);
          bar.setAttribute('aria-hidden', showing ? 'false' : 'true');
        });
      }, {threshold: 0});
      io.observe(buy);
    }
  })();
</script>

{% schema %}
{
  "name": "SCC Buy Module",
  "settings": [
    { "type": "text", "id": "banner_text", "label": "Offer banner", "default": "Buy two — second sleeve 50% off" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Cord Cushion" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "A matte woven sleeve for the tender cable. Fit it once, forget it for the season." },
    { "type": "product", "id": "product_single", "label": "Single product" },
    { "type": "product", "id": "product_twin", "label": "Twin Pack product" },
    { "type": "image_picker", "id": "gallery_1", "label": "Gallery image 1 (packaging)" },
    { "type": "image_picker", "id": "gallery_2", "label": "Gallery image 2" },
    { "type": "image_picker", "id": "gallery_3", "label": "Gallery image 3" },
    { "type": "image_picker", "id": "gallery_4", "label": "Gallery image 4" },
    { "type": "text", "id": "select_label", "label": "Selector label", "default": "Select quantity" },
    { "type": "text", "id": "tab1_label", "label": "Tab 1 label", "default": "1 sleeve" },
    { "type": "text", "id": "tab2_label", "label": "Tab 2 label", "default": "2 sleeves" },
    { "type": "text", "id": "tab2_sub", "label": "Tab 2 sub line", "default": "Second one half price" },
    { "type": "text", "id": "check_1", "label": "Checklist item 1", "default": "Fits the cable of common battery tenders" },
    { "type": "text", "id": "check_2", "label": "Checklist item 2", "default": "Fitted in under a minute, no tools" },
    { "type": "text", "id": "check_3", "label": "Checklist item 3", "default": "Stays put for the whole storage season" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "assure_1_title", "label": "Assurance 1 title", "default": "Shipping" },
    { "type": "text", "id": "assure_1_body", "label": "Assurance 1 body", "default": "Ships from Australia with tracking" },
    { "type": "text", "id": "assure_2_title", "label": "Assurance 2 title", "default": "Soft shell" },
    { "type": "text", "id": "assure_2_body", "label": "Assurance 2 body", "default": "No hardware anywhere the car can feel" },
    { "type": "text", "id": "assure_3_title", "label": "Assurance 3 title", "default": "Wipe clean" },
    { "type": "text", "id": "assure_3_body", "label": "Assurance 3 body", "default": "A damp microfibre cloth is all it needs" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Pricing in AUD. International destinations supported at checkout." }
  ],
  "presets": [{ "name": "SCC Buy Module" }]
}
{% endschema %}
