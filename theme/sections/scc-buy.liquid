{%- comment -%}
  Supercar Cellar — Buy module. Single vs Twin Pack cards with anchored savings,
  AJAX add-to-cart (/cart/add.js), Product JSON-LD, sticky mobile buy bar.
  Products come from section settings (defaults set in the page template JSON).
{%- endcomment -%}

{%- assign p_single = section.settings.product_single -%}
{%- assign p_twin = section.settings.product_twin -%}

{%- style -%}
  .scc-buy{border-block:1px solid var(--scc-line,rgba(230,231,234,.08));background:var(--scc-panel,#111114);
    padding-block:var(--scc-gap,96px);scroll-margin-top:90px}
  .scc-buy__grid{display:grid;gap:22px;margin-top:52px}
  .scc-buy__card{position:relative;border:1px solid var(--scc-line,rgba(230,231,234,.08));border-radius:2px;
    background:var(--scc-bg,#0a0a0c);padding:clamp(26px,3vw,40px);cursor:pointer;
    transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease}
  .scc-buy__card:hover{transform:translateY(-4px);border-color:rgba(230,231,234,.25);box-shadow:0 18px 44px rgba(0,0,0,.45)}
  .scc-buy__card[aria-checked="true"]{border-color:var(--scc-acc,#8e1f2c);box-shadow:inset 0 0 0 1px var(--scc-acc,#8e1f2c)}
  .scc-buy__flag{position:absolute;top:-11px;left:26px;background:var(--scc-acc,#8e1f2c);color:#fff;
    font-size:10.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:4px 10px;border-radius:2px}
  .scc-buy__name{font-size:13px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;margin-bottom:16px}
  .scc-buy__price{font-size:clamp(30px,3vw,42px);font-weight:800;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
  .scc-buy__was{color:var(--scc-mut,#9ea0a8);font-size:15px;text-decoration:line-through;margin-left:10px}
  .scc-buy__note{color:var(--scc-mut,#9ea0a8);font-size:14px;margin-top:12px;max-width:34ch}
  .scc-buy__radio{position:absolute;top:24px;right:24px;width:20px;height:20px;border-radius:50%;
    border:1.5px solid rgba(230,231,234,.35)}
  .scc-buy__card[aria-checked="true"] .scc-buy__radio{border-color:var(--scc-acc-hi,#a52534);
    background:radial-gradient(circle at center,var(--scc-acc-hi,#a52534) 0 45%,transparent 50%)}
  .scc-buy__actions{margin-top:34px;display:grid;gap:14px}
  .scc-buy__submit{width:100%;justify-content:center;font-size:15px;padding:20px 34px}
  .scc-buy__msg{font-size:13.5px;color:var(--scc-mut,#9ea0a8);text-align:center;min-height:1.2em}
  .scc-buy__msg.is-ok{color:#8fbf9a}
  .scc-buy__msg.is-err{color:#d98b95}
  @media(min-width:768px){.scc-buy__grid{grid-template-columns:1fr 1fr;gap:26px}.scc-buy__actions{max-width:520px}}

  .scc-stickybar{position:fixed;left:0;right:0;bottom:0;z-index:40;display:none;background:rgba(10,10,12,.92);
    backdrop-filter:blur(10px);border-top:1px solid var(--scc-line,rgba(230,231,234,.08));padding:12px 16px}
  .scc-stickybar.is-on{display:flex;align-items:center;justify-content:space-between;gap:16px}
  .scc-stickybar__price{font-weight:800;font-size:18px;font-variant-numeric:tabular-nums}
  .scc-stickybar__label{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--scc-mut,#9ea0a8)}
  .scc-stickybar .scc-btn{padding:14px 26px;font-size:13px}
  @media(min-width:900px){.scc-stickybar.is-on{display:none}}
{%- endstyle -%}

<div class="scc">
  <section class="scc-buy" id="scc-buy">
    <div class="scc-wrap">
      <p class="scc-label scc-reveal">{{ section.settings.eyebrow }}</p>
      <h2 class="scc-h2 scc-reveal" style="font-size:clamp(30px,3.8vw,52px);font-weight:800;letter-spacing:-.02em;margin-top:18px;line-height:1.04">{{ section.settings.heading }}</h2>

      <form id="scc-buy-form">
        <div class="scc-buy__grid" role="radiogroup" aria-label="Choose your pack">

          {%- if p_single != blank and p_single.variants.first != blank -%}
          <div class="scc-buy__card scc-reveal" role="radio" aria-checked="true" tabindex="0"
               data-variant-id="{{ p_single.variants.first.id }}"
               data-price="{{ p_single.variants.first.price | money }}"
               data-available="{{ p_single.variants.first.available }}">
            <p class="scc-buy__name">{{ section.settings.card1_label }}</p>
            <p class="scc-buy__price">{{ p_single.variants.first.price | money }}</p>
            <p class="scc-buy__note">{{ section.settings.card1_note }}</p>
            <span class="scc-buy__radio" aria-hidden="true"></span>
          </div>
          {%- endif -%}

          {%- if p_twin != blank and p_twin.variants.first != blank -%}
          <div class="scc-buy__card scc-reveal" role="radio" aria-checked="false" tabindex="0"
               data-variant-id="{{ p_twin.variants.first.id }}"
               data-price="{{ p_twin.variants.first.price | money }}"
               data-available="{{ p_twin.variants.first.available }}"
               style="transition-delay:.08s">
            <span class="scc-buy__flag">{{ section.settings.card2_flag }}</span>
            <p class="scc-buy__name">{{ section.settings.card2_label }}</p>
            <p class="scc-buy__price">{{ p_twin.variants.first.price | money }}
              {%- if p_single != blank -%}
                <span class="scc-buy__was">{{ p_single.variants.first.price | times: 2 | money }}</span>
              {%- endif -%}
            </p>
            <p class="scc-buy__note">{{ section.settings.card2_note }}</p>
            <span class="scc-buy__radio" aria-hidden="true"></span>
          </div>
          {%- endif -%}

        </div>

        <div class="scc-buy__actions scc-reveal">
          <button type="submit" class="scc-btn scc-buy__submit">{{ section.settings.button_label }}</button>
          <p class="scc-buy__msg" id="scc-buy-msg" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>
  </section>

  <div class="scc-stickybar" id="scc-stickybar" aria-hidden="true">
    <div>
      <p class="scc-stickybar__label">Cord Cushion</p>
      <p class="scc-stickybar__price" id="scc-stickybar-price">
        {%- if p_single != blank -%}{{ p_single.variants.first.price | money }}{%- endif -%}
      </p>
    </div>
    <a class="scc-btn" href="#scc-buy">{{ section.settings.button_label }}</a>
  </div>
</div>

{%- if p_single != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ p_single.title | json }},
  "description": {{ p_single.description | strip_html | truncate: 300 | json }},
  "image": [{%- for img in p_single.images -%}{{ img | image_url: width: 1254 | prepend: 'https:' | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
  "brand": { "@type": "Brand", "name": "Supercar Cellar" },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "lowPrice": {{ p_single.variants.first.price | divided_by: 100.0 | json }},
    "highPrice": {% if p_twin != blank %}{{ p_twin.variants.first.price | divided_by: 100.0 | json }}{% else %}{{ p_single.variants.first.price | divided_by: 100.0 | json }}{% endif %},
    "availability": "https://schema.org/{% if p_single.available %}InStock{% else %}PreOrder{% endif %}"
  }
}
</script>
{%- endif -%}

<script>
  (function(){
    var form = document.getElementById('scc-buy-form');
    if(!form) return;
    var cards = form.querySelectorAll('[role="radio"]');
    var msg = document.getElementById('scc-buy-msg');
    var stickyPrice = document.getElementById('scc-stickybar-price');

    function select(card){
      cards.forEach(function(c){ c.setAttribute('aria-checked', c === card ? 'true' : 'false'); });
      if(stickyPrice) stickyPrice.textContent = card.dataset.price;
    }
    cards.forEach(function(card){
      card.addEventListener('click', function(){ select(card); });
      card.addEventListener('keydown', function(e){
        if(e.key === ' ' || e.key === 'Enter'){ e.preventDefault(); select(card); }
      });
    });

    form.addEventListener('submit', function(e){
      e.preventDefault();
      var chosen = form.querySelector('[aria-checked="true"]');
      if(!chosen){ return; }
      msg.className = 'scc-buy__msg';
      msg.textContent = 'Adding…';
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: Number(chosen.dataset.variantId), quantity: 1 })
      }).then(function(r){
        if(!r.ok) throw r;
        return r.json();
      }).then(function(){
        msg.className = 'scc-buy__msg is-ok';
        msg.innerHTML = 'Added. <a href="/cart" style="color:inherit;text-decoration:underline">Review your cart</a>';
        document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
      }).catch(function(){
        msg.className = 'scc-buy__msg is-err';
        msg.textContent = 'Could not add to cart. If the store is still in draft, this works once the product is published.';
      });
    });

    var buy = document.getElementById('scc-buy');
    var bar = document.getElementById('scc-stickybar');
    if(buy && bar && 'IntersectionObserver' in window){
      var seenHero = false;
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(en){
          var showing = !en.isIntersecting && en.boundingClientRect.top > 0;
          bar.classList.toggle('is-on', showing);
          bar.setAttribute('aria-hidden', showing ? 'false' : 'true');
        });
      }, {threshold: 0});
      io.observe(buy);
    }
  })();
</script>

{% schema %}
{
  "name": "SCC Buy Module",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The offer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "One car or two." },
    { "type": "product", "id": "product_single", "label": "Single product" },
    { "type": "product", "id": "product_twin", "label": "Twin Pack product" },
    { "type": "text", "id": "card1_label", "label": "Card 1 label", "default": "Single" },
    { "type": "text", "id": "card1_note", "label": "Card 1 note", "default": "One sleeve. One cable. One car that comes out of storage the way it went in." },
    { "type": "text", "id": "card2_label", "label": "Card 2 label", "default": "Twin Pack" },
    { "type": "text", "id": "card2_flag", "label": "Card 2 flag", "default": "Second sleeve half price" },
    { "type": "text", "id": "card2_note", "label": "Card 2 note", "default": "Two sleeves for the second car, or the second tender. Priced at one and a half, not two." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" }
  ],
  "presets": [{ "name": "SCC Buy Module" }]
}
{% endschema %}
